+static const char *siw917CrsfFrameName(const uint8_t type)
+{
+    switch (type)
+    {
+    case CRSF_FRAMETYPE_DEVICE_PING:
+        return "DEVICE_PING";
+    case CRSF_FRAMETYPE_DEVICE_INFO:
+        return "DEVICE_INFO";
+    case CRSF_FRAMETYPE_PARAMETER_SETTINGS_ENTRY:
+        return "PARAM_ENTRY";
+    case CRSF_FRAMETYPE_PARAMETER_READ:
+        return "PARAM_READ";
+    case CRSF_FRAMETYPE_PARAMETER_WRITE:
+        return "PARAM_WRITE";
+    case CRSF_FRAMETYPE_ELRS_STATUS:
+        return "ELRS_STATUS";
+    case CRSF_FRAMETYPE_LINK_STATISTICS:
+        return "LINK_STATS";
+    case CRSF_FRAMETYPE_HANDSET:
+        return "HANDSET";
+    default:
+        return "OTHER";
+    }
+}
+
+static const char *siw917CrsfAddressName(const uint8_t addr)
+{
+    switch (addr)
+    {
+    case CRSF_ADDRESS_BROADCAST:
+        return "BCAST";
+    case CRSF_ADDRESS_RADIO_TRANSMITTER:
+        return "RADIO";
+    case CRSF_ADDRESS_CRSF_RECEIVER:
+        return "CRSF_RX";
+    case CRSF_ADDRESS_CRSF_TRANSMITTER:
+        return "CRSF_TX";
+    case CRSF_ADDRESS_ELRS_LUA:
+        return "ELRS_LUA";
+    case CRSF_ADDRESS_FLIGHT_CONTROLLER:
+        return "FC";
+    default:
+        return "?";
+    }
+}
+
+static void siw917TraceCrsfLuaFrame(const char *dir, const uint8_t *frame, const uint8_t length)
+{
+    if (length < 4)
+    {
+        return;
+    }
+
+    const uint8_t type = frame[2];
+    const bool discoveryFrame =
+        type == CRSF_FRAMETYPE_DEVICE_PING ||
+        type == CRSF_FRAMETYPE_DEVICE_INFO;
+    const bool parameterFrame =
+        type == CRSF_FRAMETYPE_PARAMETER_READ ||
+        type == CRSF_FRAMETYPE_PARAMETER_WRITE ||
+        type == CRSF_FRAMETYPE_PARAMETER_SETTINGS_ENTRY ||
+        type == CRSF_FRAMETYPE_ELRS_STATUS;
+
+    if (!discoveryFrame && !parameterFrame)
+    {
+        return;
+    }
+    if (discoveryFrame && siw917CrsfDiscoveryTraceCount >= 10)
+    {
+        return;
+    }
+    if (parameterFrame && siw917CrsfParamTraceCount >= 24)
+    {
+        return;
+    }
+
+    if (discoveryFrame)
+    {
+        siw917CrsfDiscoveryTraceCount++;
+    }
+    if (parameterFrame)
+    {
+        siw917CrsfParamTraceCount++;
+    }
+
+    printf("[CRSF_LUA] %s %s type=0x%02X total=%u len_byte=%u sync=0x%02X",
+           dir,
+           siw917CrsfFrameName(type),
+           type,
+           (unsigned)length,
+           (unsigned)frame[1],
+           frame[0]);
+    if (type >= CRSF_FRAMETYPE_DEVICE_PING && length >= 6)
+    {
+        printf(" dest=0x%02X(%s) orig=0x%02X(%s)",
+               frame[3],
+               siw917CrsfAddressName(frame[3]),
+               frame[4],
+               siw917CrsfAddressName(frame[4]));
+        if (length >= 7)
+        {
+            printf(" arg0=0x%02X", frame[5]);
+        }
+    }
+    printf(" crc=0x%02X bytes=", frame[length - 1]);
+
+    const uint8_t previewLength = std::min<uint8_t>(length, 32);
+    for (uint8_t i = 0; i < previewLength; ++i)
+    {
+        printf("%s%02X", i == 0 ? "" : " ", frame[i]);
+    }
+    if (previewLength < length)
+    {
+        printf(" ...");
+    }
+    printf("\n");
+}
+
+static void siw917CountRxFrame(const uint8_t type)
+{
+    switch (type)
+    {
+    case CRSF_FRAMETYPE_RC_CHANNELS_PACKED:
+        siw917RxRcCount++;
+        break;
+    case CRSF_FRAMETYPE_HEARTBEAT:
+        siw917RxHeartbeatCount++;
+        break;
+    case CRSF_FRAMETYPE_DEVICE_PING:
+        siw917RxPingCount++;
+        break;
+    case CRSF_FRAMETYPE_PARAMETER_READ:
+        siw917RxParamReadCount++;
+        break;
+    case CRSF_FRAMETYPE_PARAMETER_WRITE:
+        siw917RxParamWriteCount++;
+        break;
+    case CRSF_FRAMETYPE_COMMAND:
+        siw917RxCommandCount++;
+        break;
+    default:
+        siw917RxOtherCount++;
+        break;
+    }
+}
+
+static bool siw917IsLuaWriteTraceFrame(const uint8_t type)
+{
+    return type == CRSF_FRAMETYPE_DEVICE_INFO ||
+           type == CRSF_FRAMETYPE_PARAMETER_SETTINGS_ENTRY ||
+           type == CRSF_FRAMETYPE_ELRS_STATUS;
+}
+
+static void siw917CountTxFrame(const uint8_t type, const uint8_t length)
+{
+    siw917TxFrameBytes += length;
+    switch (type)
+    {
+    case CRSF_FRAMETYPE_LINK_STATISTICS:
+        siw917TxLinkCount++;
+        break;
+    case CRSF_FRAMETYPE_HANDSET:
+        siw917TxHandsetCount++;
+        break;
+    case CRSF_FRAMETYPE_DEVICE_INFO:
+        siw917TxDeviceInfoCount++;
+        break;
+    case CRSF_FRAMETYPE_PARAMETER_SETTINGS_ENTRY:
+        siw917TxParamEntryCount++;
+        break;
+    case CRSF_FRAMETYPE_ELRS_STATUS:
+        siw917TxElrsStatusCount++;
+        break;
+    default:
+        siw917TxOtherCount++;
+        break;
+    }
+}
+
+static void siw917ResetCrsfProtocolCounters()
+{
+    siw917RxRcCount = 0;
+    siw917RxHeartbeatCount = 0;
+    siw917RxPingCount = 0;
+    siw917RxParamReadCount = 0;
+    siw917RxParamWriteCount = 0;
+    siw917RxCommandCount = 0;
+    siw917RxOtherCount = 0;
+    siw917TxLinkCount = 0;
+    siw917TxHandsetCount = 0;
+    siw917TxDeviceInfoCount = 0;
+    siw917TxParamEntryCount = 0;
+    siw917TxElrsStatusCount = 0;
+    siw917TxOtherCount = 0;
+    siw917TxFrameBytes = 0;
+}
+#endif
