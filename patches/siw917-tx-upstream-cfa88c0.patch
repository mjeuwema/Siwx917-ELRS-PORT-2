+static uint8_t siw917CrsfCrc8(const uint8_t *data, uint16_t len, uint8_t crc = 0)
+{
+    while (len--)
+    {
+        crc ^= *data++;
+        for (uint8_t i = 0; i < 8; ++i)
+        {
+            crc = (crc & 0x80) ? (uint8_t)((crc << 1) ^ CRSF_CRC_POLY)
+                               : (uint8_t)(crc << 1);
+        }
+    }
+    return crc;
+}
